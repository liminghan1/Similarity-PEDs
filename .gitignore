# Large generated artifacts
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/matrices/*
!artifacts/matrices/.gitkeep
figures/*.png
figures/*.pdf
figures/*.svg

# Postgres data volume (docker-compose)
.pgdata/

# OS / editor
.DS_Store
.vscode/
.idea/

