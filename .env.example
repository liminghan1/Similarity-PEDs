# Copy to .env and fill in. Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=structure_to_safety
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=structure_to_safety
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy URL (psycopg v3 driver); used directly if set, otherwise assembled from the above.
DATABASE_URL=postgresql+psycopg://structure_to_safety:changeme_local_dev_only@localhost:5432/structure_to_safety

# --- External data source APIs ---
# PubChem PUG REST: no API key required (public, rate-limited — see pipelines/pubchem/README.md).
# ChEMBL web services: no API key required (public, rate-limited).
# BindingDB: no API key required for bulk/download access; document any endpoint used.
# openFDA (FAERS): no API key required for low-volume use, but an optional key raises the
# rate limit substantially (https://open.fda.gov/apis/authentication/). Register your own key.
OPENFDA_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Reproducibility ---
RANDOM_SEED=42
